# Copie para .env.local e preencha com os dados do app web no console do Firebase.
# Sem VITE_FIREBASE_API_KEY (ou com VITE_USE_EMULATOR=1) o app usa os emuladores locais.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_USE_EMULATOR=1
# App Check (reCAPTCHA v3), só produção: ver docs/seguranca.md. Sem a chave, fica desligado.
# VITE_RECAPTCHA_KEY=
