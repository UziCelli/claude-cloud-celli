{
  "name": "forca-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:gislane": "vite --mode gislane",
    "build": "tsc && vite build",
    "build:gislane": "tsc && vite build --mode gislane",
    "preview": "vite preview",
    "typecheck": "tsc && tsc -p push",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only auth,firestore --project demo-forca 'vitest run --config vitest.rules.config.ts'",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-forca 'playwright test'",
    "emuladores": "firebase emulators:start --only auth,firestore --project demo-forca",
    "icones": "pwa-assets-generator",
    "icones:gislane": "MARCA=gislane pwa-assets-generator"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "motion": "^13.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uqr": "^0.1.3"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.5"
    },
    "basic-ftp": "6.2.2",
    "gaxios": {
      "uuid": "11.1.1"
    },
    "@google-cloud/pubsub": {
      "@opentelemetry/core": "2.8.0"
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-admin": "14.5.0",
    "firebase-tools": "^15.33.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
