rules_version = '2';

// Força — regras de segurança do Firestore (testes: tests/rules.test.ts).
//
// Não existe forma de criar um coach pelo app: o primeiro coach é promovido
// manualmente no console do Firebase, editando usuarios/{uid} para
// papel = 'coach' (e status = 'ativo').
//
// Aluno "liberado" = papel 'aluno', status 'ativo' e agora < pagoAte + 7 dias (tolerância; CARENCIA_DIAS em src/lib/acesso.ts).
// Aluno bloqueado, vencido há mais de 7 dias ou aguardando não lê nem escreve mesos/registros.

service cloud.firestore {
  match /databases/{database}/documents {

    // Login anônimo do Firebase (o app não usa) não conta como logado: nem se alguém ligar no console.
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.get('sign_in_provider', '') != 'anonymous';
    }

    function me() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // Login que passou pelo 2º fator (TOTP). O claim mfaDispensado existe só para testes:
    // só a Admin SDK o define, e apenas o seed do emulador (e2e/seed.ts) o usa.
    function segundoFator() {
      return request.auth.token.firebase.get('sign_in_second_factor', null) != null
        || request.auth.token.get('mfaDispensado', false) == true;
    }

    // Todo poder de coach exige o 2º fator. O coach sem ele ainda lê o próprio usuarios/{uid}
    // (regra de leitura própria) para o app saber o papel e avisar.
    function isCoach() {
      return signedIn() && segundoFator() && me().papel == 'coach';
    }

    function liberado() {
      return signedIn()
        && me().papel == 'aluno'
        && me().status == 'ativo'
        && request.time < me().pagoAte + duration.value(7, 'd');
    }

    function own(data) {
      return signedIn() && data.alunoId == request.auth.uid;
    }

    function nomeValido(nome) {
      return nome is string && nome.size() >= 1 && nome.size() <= 80;
    }

    // Tipos dos campos que o aluno grava no registro (valem para o resultado final do merge).
    function registroValido(d) {
      return d.atualizadoEm == request.time
        && d.get('realizado', false) is bool
        && d.get('cargas', {}) is map
        && d.get('reps', {}) is map
        && d.get('pc', {}) is map;
    }

    // Peso corporal do aluno (kg): número entre 20 e 300.
    function pesoValido(p) {
      return p is number && p >= 20 && p <= 300;
    }

    // Versão da Política de Privacidade aceita: texto de 1 a 20 caracteres.
    function versaoValida(v) {
      return v is string && v.size() >= 1 && v.size() <= 20;
    }

    // Mensalidade do Pix (R$, definida pelo coach): número maior que 0 e até 100000.
    function mensalidadeValida(v) {
      return v is number && v > 0 && v <= 100000;
    }

    match /usuarios/{uid} {
      // Lê o próprio mesmo bloqueado (o app mostra a tela "bloqueado").
      allow read: if isCoach() || (signedIn() && request.auth.uid == uid);

      // Coach: no próprio perfil faz tudo; nos das outras pessoas, o resultado é sempre 'aluno'
      // (ninguém vira coach pelo app). Apagar: só o coach.
      allow create, update: if isCoach()
        && (request.auth.uid == uid || request.resource.data.papel == 'aluno')
        && (!('mensalidade' in request.resource.data) || mensalidadeValida(request.resource.data.mensalidade));
      allow delete: if isCoach();

      // Cadastro próprio: sempre aluno aguardando, sem pagoAte, com o e-mail do login.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['papel', 'status', 'nome', 'email', 'criadoEm', 'privacidadeEm', 'privacidadeVersao'])
        && request.resource.data.keys().hasAll(['papel', 'status', 'nome', 'email'])
        && request.resource.data.get('criadoEm', request.time) == request.time
        && request.resource.data.get('privacidadeEm', request.time) == request.time
        && (!('privacidadeVersao' in request.resource.data) || versaoValida(request.resource.data.privacidadeVersao))
        && request.resource.data.papel == 'aluno'
        && request.resource.data.status == 'aguardando'
        && nomeValido(request.resource.data.nome)
        && request.resource.data.email == request.auth.token.email;

      // Só nome, pesoKg, selo, o aceite da privacidade e o aviso "Já paguei" (pagamentoInformadoEm,
      // só com a hora do servidor; vale também vencido ou bloqueado, que é quando ele precisa pagar —
      // por isso não exige liberado()). E-mail, papel, status, pagoAte e mensalidade: só o coach
      // (o coach troca o próprio e-mail em Minha conta; aluno troca por manutenção — workflow
      // "Alterar e-mail de aluno").
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'pesoKg', 'selo', 'privacidadeEm', 'privacidadeVersao', 'pagamentoInformadoEm'])
        && nomeValido(request.resource.data.nome)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['selo'])
            || request.resource.data.selo is bool)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['pesoKg'])
            || pesoValido(request.resource.data.pesoKg))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['privacidadeEm'])
            || request.resource.data.privacidadeEm == request.time)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['privacidadeVersao'])
            || versaoValida(request.resource.data.privacidadeVersao))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['pagamentoInformadoEm'])
            || request.resource.data.pagamentoInformadoEm == request.time);
    }

    // Foto de perfil: fotos/{uid} = { img, atualizadoEm }. img é um JPEG de 192x192 em data URL
    // (~10 a 25 mil caracteres; teto de 60000). Só o dono grava (o coach não cria nem altera a de
    // ninguém); dono e coach leem e apagam. A regex barra PNG/SVG/javascript:/qualquer outro texto.
    match /fotos/{uid} {
      allow read: if isCoach() || (signedIn() && request.auth.uid == uid);
      allow delete: if isCoach() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['img', 'atualizadoEm'])
        && request.resource.data.keys().hasAll(['img', 'atualizadoEm'])
        && request.resource.data.img is string
        && request.resource.data.img.size() <= 60000
        && request.resource.data.img.matches('data:image/jpeg;base64,[A-Za-z0-9+/]+=*')
        && request.resource.data.atualizadoEm == request.time;
    }

    // Dia 'AAAA-MM-DD' de até 14 dias atrás até amanhã ("hoje" = fuso de São Paulo, UTC-3, sem horário
    // de verão). Aceita amanhã porque o app usa o relógio do aparelho: adiantado alguns segundos perto da
    // meia-noite, ele grava o dia seguinte, e recusar faria a marcação sumir.
    // Data inválida (mês 13, dia 32...) dá erro na conversão, e erro nega.
    function diaCardioValido(dia) {
      let p = dia.split('-');
      let d = timestamp.date(int(p[0]), int(p[1]), int(p[2]));
      let hoje = (request.time - duration.value(3, 'h')).date();
      return dia.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d <= hoje + duration.value(1, 'd')
        && d >= hoje - duration.value(14, 'd');
    }

    // Cardio do dia: cardios/{uid}_{AAAA-MM-DD} = { alunoId, dia, em, tipo?, min? }. Um por aluno por dia.
    // O aluno liberado grava (setDoc inteiro), lê e apaga os próprios; o coach lê e apaga, nunca grava.
    // get e delete conferem o dono pelo id (o app lê o doc de hoje antes de existir: resource == null);
    // list confere pelo dado (consulta alunoId == uid).
    match /cardios/{id} {
      allow get, delete: if isCoach()
        || (liberado() && id.matches(request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}'));
      allow list: if isCoach() || (own(resource.data) && liberado());

      allow create, update: if own(request.resource.data) && liberado()
        && request.resource.data.keys().hasOnly(['alunoId', 'dia', 'em', 'min', 'tipo'])
        && request.resource.data.keys().hasAll(['alunoId', 'dia', 'em'])
        && request.resource.data.dia is string
        && id == request.auth.uid + '_' + request.resource.data.dia
        && diaCardioValido(request.resource.data.dia)
        && request.resource.data.em == request.time
        && (!('min' in request.resource.data)
            || (request.resource.data.min is int && request.resource.data.min >= 1 && request.resource.data.min <= 600))
        && (!('tipo' in request.resource.data)
            || request.resource.data.tipo in ['caminhada', 'corrida', 'esteira', 'bicicleta', 'eliptico', 'escada', 'outro']);
    }

    // Sua opinião: feedbacks/{id automático} = { nota, assunto, em, tipo?, texto?, alunoId?, depoimento? }.
    // Aluno liberado só cria. Anônimo = sem alunoId (nada liga ao aluno). Só o coach lê, marca `lido` e apaga.
    // Depoimento (uso na divulgação) exige nome, nota 5 e texto.
    match /feedbacks/{id} {
      allow read, delete: if isCoach();
      allow update: if isCoach()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lido'])
        && request.resource.data.lido is bool;

      allow create: if liberado()
        && request.resource.data.keys().hasOnly(['nota', 'assunto', 'tipo', 'texto', 'alunoId', 'depoimento', 'em'])
        && request.resource.data.keys().hasAll(['nota', 'assunto', 'em'])
        && request.resource.data.nota is int
        && request.resource.data.nota >= 1 && request.resource.data.nota <= 5
        && request.resource.data.assunto in ['app', 'treinos', 'atendimento']
        && request.resource.data.em == request.time
        && (!('tipo' in request.resource.data)
            || request.resource.data.tipo in ['sugestao', 'elogio', 'critica', 'problema'])
        && (!('texto' in request.resource.data)
            || (request.resource.data.texto is string
                && request.resource.data.texto.size() >= 1 && request.resource.data.texto.size() <= 1000))
        && (!('alunoId' in request.resource.data) || request.resource.data.alunoId == request.auth.uid)
        && (!('depoimento' in request.resource.data)
            || (request.resource.data.depoimento == true
                && 'alunoId' in request.resource.data
                && request.resource.data.nota == 5
                && 'texto' in request.resource.data));
    }

    match /mesos/{mesoId} {
      allow read: if isCoach() || (own(resource.data) && liberado());
      allow write: if isCoach();
    }

    // Id: {mesoId}_s{WW}_t{T}, ex.: abc_s01_t1.
    match /registros/{regId} {
      allow read: if isCoach() || (own(resource.data) && liberado());
      allow write: if isCoach();

      allow create: if own(request.resource.data) && liberado()
        && request.resource.data.keys().hasOnly(
             ['alunoId', 'mesoId', 'semana', 'treino', 'realizado', 'realizadoEm', 'inicioEm', 'cargas', 'reps', 'pc', 'atualizadoEm'])
        && request.resource.data.semana is int
        && request.resource.data.treino is int
        && registroValido(request.resource.data)
        && request.resource.data.get('realizadoEm', null) in [null, request.time]
        && request.resource.data.get('inicioEm', null) in [null, request.time]
        && regId == request.resource.data.mesoId
             + '_s' + (request.resource.data.semana < 10 ? '0' : '') + string(request.resource.data.semana)
             + '_t' + string(request.resource.data.treino)
        && get(/databases/$(database)/documents/mesos/$(request.resource.data.mesoId)).data.alunoId
             == request.auth.uid
        && request.resource.data.semana >= 1
        && request.resource.data.semana
             <= get(/databases/$(database)/documents/mesos/$(request.resource.data.mesoId)).data.semanas
        && request.resource.data.treino >= 1
        && request.resource.data.treino
             <= get(/databases/$(database)/documents/mesos/$(request.resource.data.mesoId)).data.frequencia;

      // Gravação campo a campo (merge): identidade do registro não muda.
      // reps = reps feitas (opcional), mesmo formato das cargas.
      // pc = kg do corpo usado por exercício (slotId → número; 0 = desligado).
      allow update: if own(resource.data) && liberado()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['realizado', 'realizadoEm', 'inicioEm', 'cargas', 'reps', 'pc', 'atualizadoEm'])
        && registroValido(request.resource.data)
        && request.resource.data.get('realizadoEm', null)
             in [resource.data.get('realizadoEm', null), null, request.time]
        // inicioEm (tempo real do treino): só a hora do servidor; pode ser removido ("Cancelar treino").
        && request.resource.data.get('inicioEm', null)
             in [resource.data.get('inicioEm', null), request.time, null];
    }

    // Notas por exercício do aluno: notas/{alunoId} = { alunoId, exercicios: {nome: texto}, datas: {nome: quando}, atualizadoEm }.
    // datas é opcional (anotações antigas não têm).
    match /notas/{alunoId} {
      allow read, write: if isCoach();

      allow read: if signedIn() && request.auth.uid == alunoId && liberado();

      allow create, update: if signedIn() && request.auth.uid == alunoId && liberado()
        && request.resource.data.keys().hasOnly(['alunoId', 'exercicios', 'datas', 'atualizadoEm'])
        && request.resource.data.alunoId == request.auth.uid
        && request.resource.data.exercicios is map
        && request.resource.data.exercicios.size() <= 300
        && request.resource.data.get('datas', {}) is map
        && request.resource.data.get('datas', {}).size() <= 300
        && request.resource.data.atualizadoEm == request.time;
    }

    // Pedido de exclusão total (LGPD): exclusoes/{uid} = { em }. O coach cria ao apagar o aluno; o
    // workflow diário "Limpeza LGPD" (Admin SDK, ignora estas regras) apaga o login e o resto e,
    // por fim, o pedido. Só o coach lê e apaga; ninguém mais toca.
    match /exclusoes/{uid} {
      allow read, delete: if isCoach();
      allow create, update: if isCoach()
        && request.resource.data.keys().hasOnly(['em'])
        && request.resource.data.keys().hasAll(['em'])
        && request.resource.data.em == request.time;
    }

    // Alerta arquivado pelo coach: arquivados/{chave} = { em }. A chave muda quando a situação muda
    // (chaveAlerta em src/lib/alertas.ts), então o alerta volta sozinho com dado novo. Só o coach toca.
    match /arquivados/{chave} {
      allow read, delete: if isCoach();
      allow create, update: if isCoach()
        && request.resource.data.keys().hasOnly(['em'])
        && request.resource.data.keys().hasAll(['em'])
        && request.resource.data.em == request.time;
    }

    // Relatório do fim do ciclo: relatorios/{mesoId}. Os números são calculados na hora (src/lib/relatorio.ts);
    // aqui fica só o comentário do coach e se já foi liberado. liberadoEm != null exatamente quando liberado.
    // O aluno só lê o próprio, liberado, estando ativo e em dia (consulta: alunoId == uid e liberado == true).
    match /relatorios/{mesoId} {
      allow read: if isCoach()
        || (own(resource.data) && resource.data.liberado == true && liberado());
      allow delete: if isCoach();
      allow create, update: if isCoach()
        && request.resource.data.keys().hasOnly(['alunoId', 'mesoId', 'comentario', 'liberado', 'liberadoEm', 'atualizadoEm'])
        && request.resource.data.keys().hasAll(['alunoId', 'mesoId', 'comentario', 'liberado', 'liberadoEm', 'atualizadoEm'])
        && request.resource.data.mesoId == mesoId
        && request.resource.data.alunoId == get(/databases/$(database)/documents/mesos/$(mesoId)).data.alunoId
        && request.resource.data.comentario is string
        && request.resource.data.comentario.size() <= 3000
        && request.resource.data.liberado is bool
        && (request.resource.data.liberado
              ? request.resource.data.liberadoEm is timestamp
              : request.resource.data.liberadoEm == null)
        && request.resource.data.atualizadoEm == request.time;
    }

    // Métodos enviáveis (todos têm sinais de perigo: próprios ou ALERTA_GERAL). Os testes cruzam estas listas com src/data/fisio.ts.
    function fisioLiberavel(m) {
      return m in ['M01', 'M02', 'M03', 'M04', 'M05', 'M06', 'M07', 'M08', 'M09', 'M10', 'M11', 'M12', 'M13',
        'M14', 'M15', 'M16', 'M17', 'M18', 'M19', 'M20', 'M21', 'M22', 'M23', 'M24', 'M25'];
    }
    function fisioExigeLiberacao(m) {
      return m in ['M01', 'M02', 'M03', 'M07', 'M08', 'M16', 'M18', 'M20', 'M22', 'M24', 'M25'];
    }
    function textoFisio(t, max) {
      return t is string && t.size() <= max && t.matches('.*[^\\s].*');
    }
    function liberacaoFisio(l) {
      return l is map && l.keys().hasOnly(['profissional', 'registro', 'data'])
        && l.keys().hasAll(['profissional', 'registro', 'data'])
        && textoFisio(l.profissional, 120) && textoFisio(l.registro, 80)
        && l.data is string && l.data.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && timestamp.date(int(l.data.split('-')[0]), int(l.data.split('-')[1]), int(l.data.split('-')[2])) <= request.time;
    }
    // Lista de nomes de exercício (selo Físio no treino): até 10, cada nome com texto, até 120.
    function exercicioFisio(l, i) {
      return l.size() <= i || textoFisio(l[i], 120);
    }
    function exerciciosFisio(l) {
      return l is list && l.size() <= 10
        && exercicioFisio(l, 0) && exercicioFisio(l, 1) && exercicioFisio(l, 2) && exercicioFisio(l, 3) && exercicioFisio(l, 4)
        && exercicioFisio(l, 5) && exercicioFisio(l, 6) && exercicioFisio(l, 7) && exercicioFisio(l, 8) && exercicioFisio(l, 9);
    }
    function alunoFisio(uid) {
      return uid is string && get(/databases/$(database)/documents/usuarios/$(uid)).data.papel == 'aluno'
        && !exists(/databases/$(database)/documents/exclusoes/$(uid));
    }
    match /fisioOrientacoes/{id} {
      allow read: if isCoach() || (liberado() && own(resource.data) && resource.data.recolhida == false);
      allow delete: if isCoach(); // exclusão LGPD
      allow create: if isCoach()
        && request.resource.data.keys().hasOnly(['alunoId', 'metodoId', 'condicao', 'recado', 'contextoLiberacao', 'liberacao', 'alertasRevisados', 'recolhida', 'sinalRelatado', 'em', 'atualizadoEm', 'exercicios'])
        && (!('exercicios' in request.resource.data) || exerciciosFisio(request.resource.data.exercicios))
        && request.resource.data.keys().hasAll(['alunoId', 'metodoId', 'condicao', 'recado', 'contextoLiberacao', 'liberacao', 'alertasRevisados', 'recolhida', 'sinalRelatado', 'em', 'atualizadoEm'])
        && alunoFisio(request.resource.data.alunoId)
        && fisioLiberavel(request.resource.data.metodoId)
        && textoFisio(request.resource.data.condicao, 300)
        && request.resource.data.recado is string && request.resource.data.recado.size() <= 2000
        && request.resource.data.contextoLiberacao is bool
        && (request.resource.data.liberacao == null || liberacaoFisio(request.resource.data.liberacao))
        && (!(fisioExigeLiberacao(request.resource.data.metodoId) || request.resource.data.contextoLiberacao)
            || request.resource.data.liberacao != null)
        && request.resource.data.alertasRevisados == true
        && request.resource.data.recolhida == false && request.resource.data.sinalRelatado == false
        && request.resource.data.em == request.time && request.resource.data.atualizadoEm == request.time;
      // Edições campo a campo: nenhuma edição substitui conteúdo nem apaga sinal concorrente.
      allow update: if isCoach() && request.resource.data.atualizadoEm == request.time && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recolhida', 'atualizadoEm'])
          && request.resource.data.recolhida == true)
        // Exercícios do treino com esta orientação (selo Físio): só a lista, só enquanto não recolhida.
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['exercicios', 'atualizadoEm'])
          && resource.data.recolhida == false
          && exerciciosFisio(request.resource.data.exercicios))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['alunoId', 'atualizadoEm'])
          && alunoFisio(request.resource.data.alunoId)
          && get(/databases/$(database)/documents/usuarios/$(resource.data.alunoId)).data.get('migradoPara', '') == request.resource.data.alunoId)
      );
      allow update: if liberado() && own(resource.data) && resource.data.recolhida == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sinalRelatado', 'sinalEm', 'atualizadoEm'])
        && request.resource.data.sinalRelatado == true && resource.data.sinalRelatado == false
        && request.resource.data.sinalEm == request.time && request.resource.data.atualizadoEm == request.time;
    }

    // Relato de dor do treino (dado de saúde, Etapa 3): fisioDores/{id automático} = { alunoId, exercicio,
    // articulacao, tipo, intensidade, momento, texto?, em, atualizadoEm, resposta?, respondidoEm?, vistoEm? }.
    // O aluno (liberado) só cria o próprio, não altera nem apaga. O coach (2º fator) lê, marca visto, responde,
    // transfere (presencial → conta) e apaga (LGPD). Ids das articulações = src/lib/anatomia.ts + 'outro'.
    match /fisioDores/{id} {
      allow read: if isCoach() || (own(resource.data) && liberado());
      allow delete: if isCoach();
      allow create: if own(request.resource.data) && liberado()
        && request.resource.data.keys().hasOnly(['alunoId', 'exercicio', 'articulacao', 'tipo', 'intensidade', 'momento', 'texto', 'em', 'atualizadoEm'])
        && request.resource.data.keys().hasAll(['alunoId', 'exercicio', 'articulacao', 'tipo', 'intensidade', 'momento', 'em', 'atualizadoEm'])
        && textoFisio(request.resource.data.exercicio, 120)
        && request.resource.data.articulacao in ['ombro', 'cotovelo', 'punho', 'cervical', 'lombar', 'quadril', 'joelho', 'tornozelo', 'outro']
        && request.resource.data.tipo in ['dor', 'sensacao']
        && request.resource.data.intensidade is int
        && request.resource.data.intensidade >= 0 && request.resource.data.intensidade <= 10
        && request.resource.data.momento in ['durante', 'fim']
        && (!('texto' in request.resource.data)
            || (request.resource.data.texto is string && request.resource.data.texto.size() <= 300))
        && (request.resource.data.articulacao != 'outro'
            || ('texto' in request.resource.data && textoFisio(request.resource.data.texto, 300)))
        && request.resource.data.em == request.time
        && request.resource.data.atualizadoEm == request.time;
      allow update: if isCoach() && request.resource.data.atualizadoEm == request.time && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resposta', 'respondidoEm', 'vistoEm', 'atualizadoEm'])
          && request.resource.data.diff(resource.data).affectedKeys().hasAll(['resposta', 'respondidoEm'])
          && textoFisio(request.resource.data.resposta, 1000)
          && request.resource.data.respondidoEm == request.time
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['vistoEm'])
              || request.resource.data.vistoEm == request.time))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vistoEm', 'atualizadoEm'])
          && request.resource.data.vistoEm == request.time)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['alunoId', 'atualizadoEm'])
          && alunoFisio(request.resource.data.alunoId)
          && get(/databases/$(database)/documents/usuarios/$(resource.data.alunoId)).data.get('migradoPara', '') == request.resource.data.alunoId)
      );
    }

    // Check-in de recuperação no fim do treino (dado de saúde, rodada 4): fisioCheckins/{mesoId}_s{WW}_t{T} =
    // { alunoId, mesoId, semana, treino, sono, estresse, cansaco, alimentacao, em, atualizadoEm }, inteiros 1–5 (1 = ruim, 5 = ótimo).
    // Sem texto livre. O aluno (liberado) só cria o próprio; o coach (2º fator) lê, apaga (LGPD) e transfere.
    function nota15(n) { return n is int && n >= 1 && n <= 5; }
    match /fisioCheckins/{id} {
      allow read: if isCoach() || (own(resource.data) && liberado());
      allow delete: if isCoach();
      // Um por sessão concluída (revisão do PR, F3): id = id do registro ({mesoId}_s{WW}_t{T}), meso do próprio aluno.
      // Só create: um segundo envio da mesma sessão é update e é negado (idempotente no servidor).
      allow create: if own(request.resource.data) && liberado()
        && request.resource.data.keys().hasOnly(['alunoId', 'mesoId', 'semana', 'treino', 'sono', 'estresse', 'cansaco', 'alimentacao', 'em', 'atualizadoEm'])
        && request.resource.data.keys().hasAll(['alunoId', 'mesoId', 'semana', 'treino', 'sono', 'estresse', 'cansaco', 'alimentacao', 'em', 'atualizadoEm'])
        && request.resource.data.mesoId is string
        && request.resource.data.semana is int && request.resource.data.semana >= 1
        && request.resource.data.treino is int && request.resource.data.treino >= 1
        && id == request.resource.data.mesoId
             + '_s' + (request.resource.data.semana < 10 ? '0' : '') + string(request.resource.data.semana)
             + '_t' + string(request.resource.data.treino)
        && get(/databases/$(database)/documents/mesos/$(request.resource.data.mesoId)).data.alunoId == request.auth.uid
        && request.resource.data.semana <= get(/databases/$(database)/documents/mesos/$(request.resource.data.mesoId)).data.semanas
        && request.resource.data.treino <= get(/databases/$(database)/documents/mesos/$(request.resource.data.mesoId)).data.frequencia
        && nota15(request.resource.data.sono) && nota15(request.resource.data.estresse)
        && nota15(request.resource.data.cansaco) && nota15(request.resource.data.alimentacao)
        && request.resource.data.em == request.time
        && request.resource.data.atualizadoEm == request.time;
      allow update: if isCoach() && request.resource.data.atualizadoEm == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['alunoId', 'atualizadoEm'])
        && alunoFisio(request.resource.data.alunoId)
        && get(/databases/$(database)/documents/usuarios/$(resource.data.alunoId)).data.get('migradoPara', '') == request.resource.data.alunoId;
    }

    // Mapa opcional de medidas: só as chaves da lista (as mesmas de src/lib/avaliacao.ts; o teste compara).
    // Os valores não são conferidos aqui: só o coach grava, e a leitura ignora o que não for número na faixa.
    function mapaDe(d, campo, chaves) {
      return !(campo in d) || (d[campo] is map && d[campo].keys().hasOnly(chaves));
    }

    // Avaliação física (dado de saúde): avaliacoes/{id automático}. Só as medidas e o recado do coach;
    // IMC, % de gordura e o texto são calculados na hora (src/lib/avaliacao.ts). liberadoEm != null
    // exatamente quando liberado. Só o coach (com 2º fator) grava e apaga, e sempre para um aluno que existe.
    // O aluno só lê a própria, liberada, estando ativo e em dia (consulta: alunoId == uid e liberado == true).
    match /avaliacoes/{id} {
      allow read: if isCoach()
        || (own(resource.data) && resource.data.liberado == true && liberado());
      allow delete: if isCoach();
      allow create, update: if isCoach()
        && request.resource.data.keys().hasOnly(['alunoId', 'data', 'pesoKg', 'alturaCm', 'sexo', 'idade', 'perimetros', 'dobras', 'bio', 'lipedema', 'comentario', 'liberado', 'liberadoEm', 'atualizadoEm'])
        && request.resource.data.keys().hasAll(['alunoId', 'data', 'pesoKg', 'comentario', 'liberado', 'liberadoEm', 'atualizadoEm'])
        && request.resource.data.alunoId is string
        && get(/databases/$(database)/documents/usuarios/$(request.resource.data.alunoId)).data.papel == 'aluno'
        && request.resource.data.data is string
        && request.resource.data.data.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && pesoValido(request.resource.data.pesoKg)
        && (!('alturaCm' in request.resource.data)
            || (request.resource.data.alturaCm is number && request.resource.data.alturaCm >= 100 && request.resource.data.alturaCm <= 250))
        && (!('idade' in request.resource.data)
            || (request.resource.data.idade is int && request.resource.data.idade >= 10 && request.resource.data.idade <= 100))
        && (!('sexo' in request.resource.data) || request.resource.data.sexo in ['M', 'F'])
        && mapaDe(request.resource.data, 'perimetros', ['ombro', 'torax', 'cintura', 'abdomen', 'quadril', 'bracoD', 'bracoE', 'antebracoD', 'antebracoE', 'coxaD', 'coxaE', 'panturrilhaD', 'panturrilhaE'])
        && mapaDe(request.resource.data, 'dobras', ['peitoral', 'axilar', 'triceps', 'subescapular', 'abdominal', 'suprailiaca', 'coxa'])
        && mapaDe(request.resource.data, 'bio', ['gorduraPct', 'massaMuscularKg', 'visceral'])
        // Lipedema (condição de saúde, marcada só pelo coach): lista com até 2 itens, só braços e pernas.
        && (!('lipedema' in request.resource.data)
            || (request.resource.data.lipedema is list
                && request.resource.data.lipedema.size() <= 2
                && request.resource.data.lipedema.hasOnly(['bracos', 'pernas'])))
        && request.resource.data.comentario is string
        && request.resource.data.comentario.size() <= 3000
        && request.resource.data.liberado is bool
        && (request.resource.data.liberado
              ? request.resource.data.liberadoEm is timestamp
              : request.resource.data.liberadoEm == null)
        && request.resource.data.atualizadoEm == request.time;
    }

    // Respostas da anamnese (mapa r). Cada função aceita a chave ausente; as obrigatórias vêm no hasAll.
    function simNao(r, k) { return !(k in r) || r[k] is bool; }
    function aceite(r, k) { return !(k in r) || r[k] == true; }
    function opcao(r, k, ops) { return !(k in r) || r[k] in ops; }
    function multi(r, k, ops) { return !(k in r) || (r[k] is list && r[k].size() <= ops.size() && r[k].hasOnly(ops)); }
    function texto(r, k, max) { return !(k in r) || (r[k] is string && r[k].size() <= max); }
    function inteiro(r, k, min, max) { return !(k in r) || (r[k] is int && r[k] >= min && r[k] <= max); }

    // Chaves, opções e limites iguais aos de PERGUNTAS em src/lib/anamnese.ts (o teste compara).
    // Ao mudar as perguntas, só acrescentar chaves e opções: remover algo recusa envios offline antigos.
    function respostasValidas(r) {
      return r is map
        && r.keys().hasOnly(['coracao', 'dorPeito', 'tontura', 'doencaCronica', 'remedio', 'ossoArticulacao', 'supervisaoMedica', 'parqQual', 'gestante', 'cirurgia12m', 'fuma', 'dores', 'lesoes', 'sono', 'trabalho', 'estresse', 'objetivo', 'experiencia', 'tempoParado', 'diasSemana', 'minutos', 'outrasAtividades', 'algoMais', 'declaracao', 'responsavelConfirmou'])
        && r.keys().hasAll(['coracao', 'dorPeito', 'tontura', 'doencaCronica', 'remedio', 'ossoArticulacao', 'supervisaoMedica', 'declaracao'])
        && simNao(r, 'coracao') && simNao(r, 'dorPeito') && simNao(r, 'tontura') && simNao(r, 'doencaCronica')
        && simNao(r, 'remedio') && simNao(r, 'ossoArticulacao') && simNao(r, 'supervisaoMedica')
        && texto(r, 'parqQual', 500)
        && opcao(r, 'gestante', ['sim', 'nao', 'naoSeAplica'])
        && simNao(r, 'cirurgia12m') && simNao(r, 'fuma')
        && multi(r, 'dores', ['ombro', 'cotovelo', 'punho', 'cervical', 'lombar', 'quadril', 'joelho', 'tornozelo', 'outra'])
        && texto(r, 'lesoes', 500)
        && opcao(r, 'sono', ['ate5', '5a7', '7a8', 'mais8'])
        && opcao(r, 'trabalho', ['sentado', 'emPe', 'bracal'])
        && opcao(r, 'estresse', ['baixo', 'medio', 'alto'])
        && opcao(r, 'objetivo', ['hipertrofia', 'emagrecimento', 'forca', 'saude', 'condicionamento'])
        && opcao(r, 'experiencia', ['nunca', 'menos6m', '6ma2a', 'mais2a'])
        && opcao(r, 'tempoParado', ['treinando', 'ate3m', '3a12m', 'mais1a'])
        && inteiro(r, 'diasSemana', 1, 7)
        && opcao(r, 'minutos', ['ate30', '30a45', '45a60', 'mais60'])
        && texto(r, 'outrasAtividades', 300)
        && texto(r, 'algoMais', 1000)
        && aceite(r, 'declaracao')
        && aceite(r, 'responsavelConfirmou');
    }

    // Envio novo (aluno ou coach): campos fixos, horas do servidor, respostas conferidas.
    function anamneseNova(d) {
      return d.alunoId is string
        && d.versao is int && d.versao >= 1 && d.versao <= 1000
        && d.em == request.time
        && d.atualizadoEm == request.time
        && respostasValidas(d.r);
    }

    // Anamnese (dado de saúde, LGPD art. 11): anamneses/{id automático} = { alunoId, versao, origem, r, em,
    // atualizadoEm, obsCoach?, vistaEm? }. Primeira coleção de saúde que o ALUNO cria. Uma versão nova por
    // envio, nunca sobrescreve: o aluno (liberado) só cria a própria com origem 'aluno' e não altera nem
    // apaga. O coach (2º fator) lê, cria pelo aluno (origem 'coach'), apaga e altera só obsCoach, vistaEm e
    // alunoId (darAcessoAoApp). O aluno lê as próprias (doc ou consulta alunoId == uid), ativo e em dia;
    // ele vê também o obsCoach (o Firestore não esconde campo).
    match /anamneses/{id} {
      allow read: if isCoach() || (own(resource.data) && liberado());
      allow delete: if isCoach();

      allow create: if own(request.resource.data) && liberado()
        && request.resource.data.keys().hasOnly(['alunoId', 'versao', 'origem', 'r', 'em', 'atualizadoEm'])
        && request.resource.data.keys().hasAll(['alunoId', 'versao', 'origem', 'r', 'em', 'atualizadoEm'])
        && request.resource.data.origem == 'aluno'
        && anamneseNova(request.resource.data);

      allow create: if isCoach()
        && request.resource.data.keys().hasOnly(['alunoId', 'versao', 'origem', 'r', 'em', 'atualizadoEm', 'obsCoach', 'vistaEm'])
        && request.resource.data.keys().hasAll(['alunoId', 'versao', 'origem', 'r', 'em', 'atualizadoEm'])
        && request.resource.data.origem == 'coach'
        && anamneseNova(request.resource.data)
        && get(/databases/$(database)/documents/usuarios/$(request.resource.data.alunoId)).data.papel == 'aluno'
        && (!('obsCoach' in request.resource.data)
            || (request.resource.data.obsCoach is string && request.resource.data.obsCoach.size() <= 2000))
        && request.resource.data.get('vistaEm', request.time) == request.time;

      allow update: if isCoach()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['obsCoach', 'vistaEm', 'liberadoEm', 'alunoId', 'atualizadoEm'])
        && request.resource.data.atualizadoEm == request.time
        && (!('obsCoach' in request.resource.data)
            || (request.resource.data.obsCoach is string && request.resource.data.obsCoach.size() <= 2000))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['vistaEm'])
            || request.resource.data.vistaEm == request.time)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['liberadoEm'])
            || request.resource.data.liberadoEm == request.time)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['alunoId'])
            || (request.resource.data.alunoId is string
                && get(/databases/$(database)/documents/usuarios/$(request.resource.data.alunoId)).data.papel == 'aluno'));
    }

    // Chave da API de IA (assistente de voz, src/lib/ia.ts): segredos/ia = { chave, atualizadoEm }.
    // Só o coach (com 2º fator) lê, grava e apaga; aluno e anônimo nunca. O backup semanal ignora esta coleção.
    match /segredos/{id} {
      allow read, delete: if isCoach() && id == 'ia';
      allow create, update: if isCoach() && id == 'ia'
        && request.resource.data.keys().hasOnly(['chave', 'atualizadoEm'])
        && request.resource.data.keys().hasAll(['chave', 'atualizadoEm'])
        && request.resource.data.chave is string
        && request.resource.data.chave.size() >= 20 && request.resource.data.chave.size() <= 300
        && request.resource.data.chave.matches('sk-ant-.*')
        && request.resource.data.atualizadoEm == request.time;
    }

    // Até 20 documentos imutáveis por conta aprovada/dia UTC, mesmo fora do app.
    // A data vem do servidor; novos cadastros não podem consumir a cota de logs.
    function idLogValido(id, slot) {
      let hoje = request.time.date();
      let dia = string(hoje.year()) + '-'
        + (hoje.month() < 10 ? '0' : '') + string(hoje.month()) + '-'
        + (hoje.day() < 10 ? '0' : '') + string(hoje.day());
      return slot is int && slot >= 0 && slot < 20
        && id == request.auth.uid + '_' + dia + '_' + string(slot);
    }

    match /logs/{id} {
      allow read, delete: if isCoach();
      allow update: if false;

      allow create: if (isCoach() || (signedIn() && me().papel == 'aluno' && me().status == 'ativo'))
        && idLogValido(id, request.resource.data.slot)
        && request.resource.data.keys().hasOnly(['slot', 'tipo', 'mensagem', 'tela', 'versao', 'aparelho', 'online', 'uid', 'em'])
        && request.resource.data.keys().hasAll(['slot', 'tipo', 'mensagem', 'tela', 'versao', 'aparelho', 'online', 'uid', 'em'])
        && request.resource.data.tipo in ['erro', 'promessa', 'gravacao', 'carregando']
        && request.resource.data.mensagem is string && request.resource.data.mensagem.size() <= 500
        && request.resource.data.tela is string && request.resource.data.tela.size() <= 100
        && request.resource.data.versao is string && request.resource.data.versao.size() <= 40
        && request.resource.data.aparelho is string && request.resource.data.aparelho.size() <= 200
        && request.resource.data.online is bool
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.em == request.time;
    }
  }
}
